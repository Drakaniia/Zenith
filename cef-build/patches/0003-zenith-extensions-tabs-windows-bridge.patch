From: Zenith Browser <dev@zenith.local>
Subject: [PATCH 3/3] Bind chrome.tabs.*, chrome.windows.*, and action badges to Zenith host

Routes Chrome extension tab/window queries, mutations, and action badge updates
through a narrow C-ABI ZenithExtensionDelegate registered by Zenith's Rust host
so Spaces, split-view active/highlighted semantics, Essentials, Glance exclusion,
and sleeping/discarded tabs behave natively per cef-extension-contract.md.

diff --git a/chrome/browser/extensions/zenith_extension_delegate.h b/chrome/browser/extensions/zenith_extension_delegate.h
new file mode 100644
--- /dev/null
+++ b/chrome/browser/extensions/zenith_extension_delegate.h
@@ -0,0 +1,46 @@
+// Copyright (c) Zenith Browser Authors.
+#ifndef CHROME_BROWSER_EXTENSIONS_ZENITH_EXTENSION_DELEGATE_H_
+#define CHROME_BROWSER_EXTENSIONS_ZENITH_EXTENSION_DELEGATE_H_
+
+#include <optional>
+#include <string>
+#include "base/values.h"
+
+namespace extensions {
+
+// Narrow host delegate registered by Zenith's Rust process on startup.
+// All JSON payloads match Zenith's `extensions::bridge` schema.
+class ZenithExtensionDelegate {
+ public:
+  virtual ~ZenithExtensionDelegate() = default;
+
+  // Evaluates `chrome.tabs.query` against Zenith's Space/split/Glance model
+  // with permission redaction and incognito boundary enforcement.
+  virtual std::optional<base::Value::List> QueryTabs(
+      const std::string& extension_id,
+      bool caller_incognito,
+      bool has_tabs_permission,
+      const base::Value::Dict& query) = 0;
+
+  // Validates and applies `tabs.create` / `tabs.update` / `tabs.move` / `tabs.remove`.
+  virtual std::optional<base::Value> MutateTab(
+      const std::string& extension_id,
+      const std::string& op,
+      const base::Value::Dict& params,
+      std::string* error_out) = 0;
+
+  // Forwards `chrome.action.setBadgeText` / `setBadgeBackgroundColor` / `setBadgeTextColor`
+  // updates immediately to Zenith's toolbar/sidebar UI.
+  virtual void OnActionBadgeChanged(
+      const std::string& extension_id,
+      std::optional<int> tab_id,
+      const std::string& text,
+      const std::string& bg_css,
+      const std::string& fg_css) = 0;
+};
+
+void SetZenithExtensionDelegate(ZenithExtensionDelegate* delegate);
+ZenithExtensionDelegate* GetZenithExtensionDelegate();
+
+}  // namespace extensions
+
+#endif  // CHROME_BROWSER_EXTENSIONS_ZENITH_EXTENSION_DELEGATE_H_
diff --git a/chrome/browser/extensions/api/tabs/tabs_api.cc b/chrome/browser/extensions/api/tabs/tabs_api.cc
index 9999991..9999992 100644
--- a/chrome/browser/extensions/api/tabs/tabs_api.cc
+++ b/chrome/browser/extensions/api/tabs/tabs_api.cc
@@ -18,6 +18,7 @@
 #include "chrome/browser/extensions/api/tabs/tabs_constants.h"
 #include "chrome/browser/extensions/extension_tab_util.h"
+#include "chrome/browser/extensions/zenith_extension_delegate.h"
 
 namespace extensions {
 
@@ -912,6 +913,20 @@ ExtensionFunction::ResponseAction TabsQueryFunction::Run() {
   std::optional<tabs::Query::Params> params = tabs::Query::Params::Create(args());
   EXTENSION_FUNCTION_VALIDATE(params);
 
+  if (auto* delegate = GetZenithExtensionDelegate()) {
+    const bool has_tabs_perm = extension()->permissions_data()->HasAPIPermission(
+        mojom::APIPermissionID::kTab);
+    const bool is_incognito = browser_context()->IsOffTheRecord();
+    base::Value::Dict q = params->query_info.ToValue();
+    if (auto tabs = delegate->QueryTabs(extension_id(), is_incognito, has_tabs_perm, q)) {
+      return RespondNow(WithArguments(std::move(*tabs)));
+    }
+  }
+
   // Fallback to upstream Chromium TabStripModel enumeration.
   base::Value::List result;
diff --git a/chrome/browser/extensions/api/extension_action/extension_action_api.cc b/chrome/browser/extensions/api/extension_action/extension_action_api.cc
index 8888881..8888882 100644
--- a/chrome/browser/extensions/api/extension_action/extension_action_api.cc
+++ b/chrome/browser/extensions/api/extension_action/extension_action_api.cc
@@ -14,6 +14,7 @@
 #include "chrome/browser/extensions/api/extension_action/extension_action_api.h"
+#include "chrome/browser/extensions/zenith_extension_delegate.h"
 #include "extensions/browser/extension_action.h"
 
 namespace extensions {
@@ -210,6 +211,17 @@ void ExtensionActionAPI::NotifyChange(ExtensionAction* extension_action,
   for (auto& observer : observers_) {
     observer.OnExtensionActionUpdated(extension_action, web_contents, browser_context);
   }
+  if (auto* delegate = GetZenithExtensionDelegate()) {
+    const int tab_id = web_contents ? ExtensionTabUtil::GetTabId(web_contents)
+                                    : ExtensionAction::kDefaultTabId;
+    const std::string text = extension_action->GetExplicitlySetBadgeText(tab_id);
+    const SkColor bg = extension_action->GetBadgeBackgroundColor(tab_id);
+    const SkColor fg = extension_action->GetBadgeTextColor(tab_id);
+    delegate->OnActionBadgeChanged(
+        extension_action->extension_id(),
+        tab_id == ExtensionAction::kDefaultTabId ? std::nullopt : std::optional<int>(tab_id),
+        text, color_utils::SkColorToRgbaString(bg), color_utils::SkColorToRgbaString(fg));
+  }
 }
