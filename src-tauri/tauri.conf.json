{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenith",
  "mainBinaryName": "zenith",
  "version": "0.1.0",
  "identifier": "dev.zenith.browser",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      },
      "capabilities": ["chrome"]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlEOTU0REY4Njc5NTBGQUQKUldTdEQ1Vm4rRTJWblk4K0Vha3hFR1gxYXZiVmhIZzVpZ3V2NU44NGdCc3Uyajg5NGFpWXdXcFUK",
      "endpoints": [
        "https://github.com/Drakaniia/Zenith/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "quiet" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Zenith",
    "shortDescription": "A lightweight Zen-style web browser",
    "longDescription": "Zenith is a lightweight web browser for Windows with vertical tabs, spaces, split view, Glance and built-in ad blocking, built on Microsoft Edge WebView2.",
    "copyright": "Copyright (c) 2026 Zenith contributors",
    "category": "Productivity",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
