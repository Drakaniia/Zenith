{
  "name": "@zenith/desktop",
  "private": true,
  "version": "0.1.13",
  "description": "Zenith: a lightweight, Zen-style web browser for Windows built on Tauri 2 and WebView2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold warning",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --features tauri/custom-protocol",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "gen:avatars": "node scripts/gen-profile-avatars.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~5.9.3",
    "vite": "^8.3.6"
  }
}
