{
  "name": "zenith",
  "private": true,
  "description": "Zenith monorepo: the browser (apps/desktop), its website (apps/docs) and shared packages",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @zenith/desktop dev",
    "app:dev": "pnpm --filter @zenith/desktop app:dev",
    "app:build": "pnpm --filter @zenith/desktop app:build",
    "build": "pnpm -r --if-present build",
    "check": "pnpm -r --if-present check",
    "test": "node --test \"scripts/**/*.test.ts\" && pnpm -r --if-present test",
    "test:rust": "pnpm --filter @zenith/desktop test:rust",
    "docs:dev": "pnpm --filter @zenith/docs dev",
    "docs:build": "pnpm --filter @zenith/docs build",
    "release": "node scripts/release.mjs"
  },
  "packageManager": "pnpm@12.3.4"
}
