{
  "name": "rust-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "electron:dev": "concurrently -k -s first -n vite,electron \"pnpm dev\" \"wait-on http://localhost:1420 && electron electron/main.mjs\"",
    "electron:start": "pnpm build && electron electron/main.mjs --dist",
    "electron:test": "node --test electron/backend/*.test.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11.0",
    "@tauri-apps/plugin-shell": "~2.3.5",
    "lucide-svelte": "^0.468.0",
    "svelte": "~5.55.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.0",
    "@tauri-apps/cli": "~2.11.0",
    "concurrently": "^10.0.3",
    "electron": "^42.3.3",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^4.0.1",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "wait-on": "^9.0.10"
  },
  "packageManager": "pnpm@10.0.0"
}
